.mx_GuaThemePanel {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-4x);
    min-width: 0;
}

.mx_GuaThemePanel_layoutNote {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--cpd-space-3x);
    padding: var(--cpd-space-3x) var(--cpd-space-4x);
    border-radius: 12px;
    background-color: var(--cpd-color-bg-subtle-secondary);
    font: var(--cpd-font-body-sm-regular);
    color: var(--cpd-color-text-primary);
}

.mx_GuaThemePreview {
    position: relative;
    isolation: isolate;
    min-height: 220px;
    border-radius: 16px;
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    overflow: hidden;

    .mx_GuaWallpaper {
        z-index: -1;
    }
}

.mx_GuaThemePreview_messages {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-3x);
    padding: var(--cpd-space-4x) var(--cpd-space-3x);
    font: var(--cpd-font-body-lg-regular);
    color: var(--cpd-color-text-primary);
}

.mx_GuaThemePreview_day {
    align-self: center;
    padding: 3px 8px;
    border-radius: 12px;
    background-color: color-mix(in srgb, var(--cpd-color-bg-canvas-default) 88%, transparent);
    font: var(--cpd-font-body-sm-semibold);
}

.mx_GuaThemePreview_bubble {
    max-width: 70%;
    padding: var(--cpd-space-2x) var(--cpd-space-3x);
    border-radius: 12px;
}

.mx_GuaThemePreview_incoming {
    align-self: flex-start;
    background-color: $eventbubble-others-bg;
}

.mx_GuaThemePreview_outgoing {
    align-self: flex-end;
    background-color: $eventbubble-self-bg;
}

.mx_GuaThemePreview_send {
    position: absolute;
    right: var(--cpd-space-3x);
    bottom: var(--cpd-space-3x);
}

.mx_GuaThemePanel_buttons {
    display: flex;
    justify-content: center;
    gap: var(--cpd-space-10x);
}

.mx_GuaThemePanel_roundButton {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--cpd-space-2x);
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    font: var(--cpd-font-body-sm-semibold);
    color: var(--cpd-color-text-primary);

    &:disabled {
        cursor: default;
        color: var(--cpd-color-text-disabled);
    }
}

.mx_GuaThemePanel_circle {
    position: relative;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    overflow: hidden;
}

.mx_GuaThemePanel_swatch {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: $eventbubble-self-bg;

    svg {
        width: 24px;
        height: 24px;
        color: var(--cpd-color-icon-secondary);
    }
}

.mx_GuaThemePanel_actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--cpd-space-2x);
}

.mx_GuaThemePanel_progress {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-2x);
    font: var(--cpd-font-body-md-regular);
    color: var(--cpd-color-text-secondary);
}

.mx_GuaThemePanel_note {
    margin: 0;
    font: var(--cpd-font-body-sm-regular);
    color: var(--cpd-color-text-secondary);

    p {
        margin: 0;
    }
}

.mx_GuaThemePanel_section h3 {
    margin: 0 0 var(--cpd-space-2x);
    font: var(--cpd-font-body-md-semibold);
    color: var(--cpd-color-text-primary);
}

.mx_GuaThemeTiles {
    display: flex;
    flex-wrap: nowrap;
    gap: var(--cpd-space-3x);
    padding: var(--cpd-space-1x);
    overflow-x: auto;
}

/* Phone-shaped, 19.5 by 9 like the stills. */
.mx_GuaThemeTile {
    position: relative;
    isolation: isolate;
    flex: none;
    width: 84px;
    height: 182px;
    padding: 0;
    border-radius: 12px;
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    overflow: hidden;
    background: none;
    cursor: pointer;

    .mx_GuaWallpaper {
        z-index: -1;
    }

    &:disabled {
        cursor: default;
    }

    &:focus-visible {
        outline: 2px solid var(--cpd-color-border-focused);
        outline-offset: 2px;
    }
}

.mx_GuaThemeTile_selected {
    border: 2px solid var(--cpd-color-border-interactive-primary);
}

.mx_GuaThemeTile_bubbles {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    padding: 8px;
}

.mx_GuaThemeTile_incoming,
.mx_GuaThemeTile_outgoing {
    height: 14px;
    border-radius: 6px;
}

.mx_GuaThemeTile_incoming {
    width: 55%;
    align-self: flex-start;
    background-color: $eventbubble-others-bg;
}

.mx_GuaThemeTile_outgoing {
    width: 65%;
    align-self: flex-end;
    background-color: $eventbubble-self-bg;
}

.mx_GuaThemeTile_badge,
.mx_GuaThemeTile_name {
    position: absolute;
    left: 50%;
    bottom: 8px;
    transform: translateX(-50%);
    max-width: calc(100% - 12px);
    padding: 2px 6px;
    border-radius: 12px;
    background-color: color-mix(in srgb, var(--cpd-color-bg-canvas-default) 88%, transparent);
    font: var(--cpd-font-body-xs-semibold);
    color: var(--cpd-color-text-primary);
    text-align: center;
}

.mx_GuaThemeTile_badge {
    white-space: nowrap;
}

.mx_GuaThemeTile_name {
    width: max-content;
    overflow-wrap: anywhere;
}

.mx_GuaThemeTile_check {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    color: var(--cpd-color-icon-accent-primary);
    background-color: var(--cpd-color-bg-canvas-default);
}

.mx_GuaThemeSwatch {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    cursor: pointer;

    svg {
        width: 20px;
        height: 20px;
        color: var(--cpd-color-icon-primary);
    }

    &:focus-visible {
        outline: 2px solid var(--cpd-color-border-focused);
        outline-offset: 2px;
    }
}

.mx_GuaThemeSwatch_standard {
    background-color: $eventbubble-self-bg;
}

.mx_GuaThemePickerDialog {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-4x);
    width: min(560px, 90vw);
}

.mx_GuaThemePickerDialog_gallery {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-4x);
    max-height: 45vh;
    overflow-y: auto;
}

.mx_GuaThemeDefault {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-4x);

    .mx_GuaThemeTile {
        cursor: default;
    }
}

.mx_GuaThemeDefault_name {
    flex: 1;
    font: var(--cpd-font-body-md-semibold);
    color: var(--cpd-color-text-primary);
}

.mx_GuaThemePickerDialog_file {
    display: none;
}

.mx_GuaPhotoEditor_frame {
    cursor: grab;
    touch-action: none;
    user-select: none;
}

.mx_GuaPhotoEditor_moves {
    display: flex;
    justify-content: center;
    gap: var(--cpd-space-2x);
}

.mx_GuaPhotoEditor_controls {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-3x);
}

.mx_GuaPhotoEditor_appearance {
    display: flex;
    gap: var(--cpd-space-6x);
}

.mx_GuaPhotoEditor_dim {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-2x);
    font: var(--cpd-font-body-md-semibold);
    color: var(--cpd-color-text-primary);
}
