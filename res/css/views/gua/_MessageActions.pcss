.mx_GuaMessageActions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--cpd-space-2x);
    margin-top: var(--cpd-space-2x);
    /* Room for the focus ring, which the tile would otherwise clip */
    padding: 2px;
}
